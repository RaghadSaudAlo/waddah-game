# services/therapy-api/.env.example
#
# Copy to `.env` and fill in real values. `.env` is gitignored at the repo root
# and MUST NEVER be committed — the previous copy of this file shipped inside
# waddah_app.zip with live keys in it, which is why both keys below need
# rotating before this service is run again.
#
#   cp .env.example .env     (PowerShell:  Copy-Item .env.example .env)

# --- GPT-4 therapy feedback (app/llm_service.py) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- ElevenLabs TTS (app/tts_service.py) ---
# This service calls ElevenLabs with model_id=eleven_multilingual_v2.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
